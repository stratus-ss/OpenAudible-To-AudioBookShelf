[Unit]
Description=Audiobook Ingestion MCP Server (SSE)
After=network-online.target mnt-abs\x2dtest-audiobooks.mount
Wants=network-online.target

[Service]
Type=simple
User=stratus
WorkingDirectory=/home/stratus/OpenAudible-To-AudioBookShelf
Environment=MCP_ENV_FILE=/home/stratus/OpenAudible-To-AudioBookShelf/abs_mcp/.env
ExecStart=/home/stratus/OpenAudible-To-AudioBookShelf/venv/bin/python -m abs_mcp.mcp_server
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=audiobook-mcp

[Install]
WantedBy=multi-user.target
