# Audiobook Ingestion MCP Server Configuration

# Libation / source paths
SOURCE_AUDIO_BOOK_DIRECTORY=/path/to/libation/books
DESTINATION_BOOK_DIRECTORY=/path/to/audiobookshelf/audiobooks
LIBATION_CLI=libationcli
LIBATION_FILE_LOCATIONS_PATH=
AUDIO_FILE_EXTENSION=.m4b
COPY_INSTEAD_OF_MOVE=false
LIBATION_FOLDER_CLEANUP=false

# AudioBookShelf connection
ABS_SERVER_URL=http://your.abs.server.ip:13378
ABS_LIBRARY_ID=your-library-uuid-here
ABS_API_TOKEN=your-abs-api-token-here

# Profanity cleaning (MonkeyPlug)
ENABLE_PROFANITY_CLEANING=false
REMOTE_WHISPER_URL=
SWEARS_FILE=
WORKING_DIRECTORY=/tmp/monkeyplug-cleaning
SAVE_TRANSCRIPTS=true
TIMEOUT=600
CONFIDENCE_THRESHOLD=0.70
BEEP_MODE=false

# Multi-library configuration
# Path to YAML file mapping library names to ABS library IDs, destinations, and types.
# See libraries.example.yaml for format. If unset, looks for abs_mcp/libraries.yaml.
LIBRARIES_CONFIG=

# MCP transport
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8765
